#include <stdio.h>

// Function to perform a linear search on a 1D array
int linearSearch(int arr[], int size, int target) {
    for (int i = 0; i < size; i++) {
        // If the element matches the target, return its index
        if (arr[i] == target) {
            return i;
        }
    }
    // Return -1 if the element is not present in the array
    return -1; 
}

int main() {
    int arr[] = {12, 34, 6, 40, 23, 89, 55};
    int size = sizeof(arr) / sizeof(arr[0]); // Automatically calculate array size
    int target;

    printf("Array elements: ");
    for (int i = 0; i < size; i++) {
        printf("%d ", arr[i]);
    }
    
    printf("\nEnter the number to search for: ");
    scanf("%d", &target);

    // Call the search function
    int index = linearSearch(arr, size, target);

    // Display the results
    if (index != -1) {
        printf("Element %d found at index position: %d (Element number %d)\n", target, index, index + 1);
    } else {
        printf("Element %d was not found in the array.\n", target);
    }

    return 0;
}
