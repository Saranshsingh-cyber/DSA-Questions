#include <stdio.h>
#include <stdlib.h>

#define MAX 100

// Function prototypes
void display(int arr[], int size);
int insert(int arr[], int size, int element, int capacity, int position);
int deleteElement(int arr[], int size, int position);

int main() {
    int arr[MAX] = {10, 20, 30, 40, 50}; // Initial array
    int size = 5;                        // Current number of elements
    int choice, element, position;

    while (1) {
        printf("\n--- ARRAY OPERATIONS ---");
        printf("\n1. Insert");
        printf("\n2. Delete");
        printf("\n3. Display");
        printf("\n4. Exit");
        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                printf("Enter element to insert: ");
                scanf("%d", &element);
                printf("Enter position (0 to %d): ", size);
                scanf("%d", &position);
                
                size = insert(arr, size, element, MAX, position);
                break;

            case 2:
                printf("Enter position to delete (0 to %d): ", size - 1);
                scanf("%d", &position);
                
                size = deleteElement(arr, size, position);
                break;

            case 3:
                display(arr, size);
                break;

            case 4:
                printf("Exiting program.\n");
                exit(0);

            default:
                printf("Invalid choice! Please try again.\n");
        }
    }
    return 0;
}

// 1. Display Operation
void display(int arr[], int size) {
    if (size == 0) {
        printf("Array is empty.\n");
        return;
    }
    printf("Array elements: ");
    for (int i = 0; i < size; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
}

// 2. Insertion Operation
int insert(int arr[], int size, int element, int capacity, int position) {
    // Check for overflow
    if (size >= capacity) {
        printf("Error: Array is full (Overflow)!\n");
        return size;
    }
    // Check for invalid position
    if (position < 0 || position > size) {
        printf("Error: Invalid position!\n");
        return size;
    }

    // Shift elements to the right to make space
    for (int i = size - 1; i >= position; i--) {
        arr[i + 1] = arr[i];
    }

    // Insert the element and increase size
    arr[position] = element;
    printf("Element inserted successfully.\n");
    return size + 1;
}

// 3. Deletion Operation
int deleteElement(int arr[], int size, int position) {
    // Check for underflow
    if (size == 0) {
        printf("Error: Array is empty (Underflow)!\n");
        return size;
    }
    // Check for invalid position
    if (position < 0 || position >= size) {
        printf("Error: Invalid position!\n");
        return size;
    }

    // Shift elements to the left to fill the gap
    for (int i = position; i < size - 1; i++) {
        arr[i] = arr[i + 1];
    }

    printf("Element deleted successfully.\n");
    return size - 1;
}
