#include <stdio.h>

void mergeArrays(int arr1[], int n1, int arr2[], int n2, int res[]) {
    int i = 0, j = 0, k = 0;

    // Copy elements of first array
    for (i = 0; i < n1; i++) {
        res[k++] = arr1[i];
    }

    // Copy elements of second array
    for (j = 0; j < n2; j++) {
        res[k++] = arr2[j];
    }
}

int main() {
    int arr1[] = {1, 3, 5, 7};
    int n1 = sizeof(arr1) / sizeof(arr1[0]);

    int arr2[] = {2, 4, 6, 8};
    int n2 = sizeof(arr2) / sizeof(arr2[0]);

    int res[n1 + n2];

    // Merge arrays
    mergeArrays(arr1, n1, arr2, n2, res);

    // Print the merged array
    printf("Merged array: \n");
    for (int i = 0; i < n1 + n2; i++) {
        printf("%d ", res[i]);
    }
    printf("\n");

    return 0;
}
